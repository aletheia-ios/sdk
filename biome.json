{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "all",
      "a11y": "error",
      "complexity": "error",
      "correctness": {
        "useImportExtensions": "off",
        "useQwikValidLexicalScope": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noReExportAll": "off"
      },
      "security": {
        "noSecrets": "off"
      },
      "style": {
        "noContinue": "off",
        "noTernary": "off",
        "useBlockStatements": "off",
        "useExportsLast": "off",
        "useNumericSeparators": "off",
        "useNamingConvention": {
          "level": "error",
          "options": { "strictCase": false }
        }
      },
      "suspicious": {
        "noTemplateCurlyInString": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["*.config.ts", "scripts/**", "test/**", "src/**/*.test.ts"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "off" },
          "performance": { "noDelete": "off", "useTopLevelRegex": "off" },
          "style": { "noDefaultExport": "off", "noMagicNumbers": "off" }
        }
      }
    },
    {
      "includes": ["src/utils/bytes.ts", "src/utils/dates.ts"],
      "linter": {
        "rules": {
          "style": { "noMagicNumbers": "off" },
          "suspicious": { "noBitwiseOperators": "off" }
        }
      }
    },
    {
      "includes": ["src/host/bridge.ts"],
      "linter": {
        "rules": {
          "style": { "useConsistentMethodSignatures": "off" }
        }
      }
    }
  ]
}
